{
  "name": "pynote",
  "version": "0.1.0",
  "description": "Live Python cells for your website: PyNote's editable code cells, running in the browser with Pyodide. Cells on a page share one runtime, like a notebook. React, Solid, Astro and plain HTML.",
  "license": "MIT",
  "author": "Anas Bouzid",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bouzidanas/pynote-notebook-editor.git",
    "directory": "packages/pynote"
  },
  "homepage": "https://github.com/bouzidanas/pynote-notebook-editor/tree/main/packages/pynote#readme",
  "keywords": ["python", "notebook", "pyodide", "codemirror", "react", "solid", "astro", "mdx", "astro-component"],
  "sideEffects": ["./dist/index.js", "./dist/element.js"],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./dist/react.js"
    },
    "./solid": {
      "types": "./types/solid.d.ts",
      "solid": "./solid/index.jsx",
      "default": "./dist/solid.js"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "default": "./dist/element.js"
    },
    "./astro": {
      "types": "./types/astro.d.ts",
      "default": "./astro/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pynote": "./dist/cli.js"
  },
  "files": ["dist", "types", "solid", "astro", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.11",
    "@lezer/highlight": "^1.2.3",
    "astro": ">=4",
    "pyodide": "0.29.4",
    "react": ">=18",
    "solid-js": "^1.8"
  },
  "peerDependenciesMeta": {
    "astro": { "optional": true },
    "pyodide": { "optional": true },
    "react": { "optional": true },
    "solid-js": { "optional": true }
  }
}
